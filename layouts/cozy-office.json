{
  "id": "root",
  "type": "row",
  "preview": "layouts/cozy-office.png",
  "theme": {
    "light": "cozy-office-light",
    "dark": "cozy-office-dark"
  },
  "background": "chrome",
  "titlebar": "none",
  "traffic_lights": [
    14,
    16
  ],
  "terminal_padding": [
    14,
    12
  ],
  "children": [
    {
      "id": "rail",
      "type": "column",
      "size": {
        "px": 248
      },
      "min": 200,
      "max": 320,
      "resizable": true,
      "window_drag": true,
      "background": "chrome",
      "children": [
        {
          "id": "rail-spaces",
          "type": "block",
          "content": {
            "mod": "cozy-rail"
          }
        },
        {
          "id": "rail-accounts",
          "type": "block",
          "size": {
            "px": 300
          },
          "content": {
            "mod": "cozy-accounts",
            "props": {
              "role": "rail"
            }
          }
        },
        {
          "id": "rail-buttons",
          "type": "block",
          "size": {
            "px": 52
          },
          "content": {
            "mod": "cozy-rail",
            "props": {
              "role": "buttons"
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "padding": 8,
      "gap": 8,
      "children": [
        {
          "id": "office-strip",
          "type": "row",
          "size": {
            "px": 30
          },
          "gap": 0,
          "window_drag": true,
          "padding": [
            0,
            0
          ],
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "cozy-tabs"
              },
              "min": 120,
              "window_drag": false
            },
            {
              "id": "strip-tools",
              "type": "block",
              "content": {
                "mod": "cozy-office",
                "props": {
                  "role": "strip"
                }
              },
              "size": {
                "px": 0
              }
            }
          ]
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "header": {
                "content": {
                  "mod": "cozy-pane"
                },
                "reveal": "always",
                "height": 30,
                "position": "top"
              },
              "background": "background",
              "focus": {
                "width": 2,
                "color": "accent"
              },
              "radius": 12,
              "gap": 8,
              "lone": true
            }
          },
          "background": "chrome",
          "radius": 12,
          "shadow": "sm"
        }
      ]
    }
  ]
}
